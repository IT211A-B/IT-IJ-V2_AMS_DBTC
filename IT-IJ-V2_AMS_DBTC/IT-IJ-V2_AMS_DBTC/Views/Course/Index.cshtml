@{
	@using IT_IJ_V2_AMS_DBTC.Models;
	@model IEnumerable<StudentModels>
}

@section Styles {
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/jquery/student.js" asp-append-version="true"></script>
}
<!--Header-->
<div class="page-header">
	<span class="card-title">Course List</span>
	<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Add Course</button>
</div>

<!--Search Row-->
<div class="search-row">
	<input type="text" id="searchInput" placeholder="Search by name or email..." />
</div>

<!--Course Table-->
<table id="course-table" class="table">
	<thead>
		<tr>
			<th>CourseID</th>
			<th>Course Name</th>
			<th>Course Description</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody id="courseTableBody">
	</tbody>
</table>

<!-- Create Modal -->
<div class="modal fade" id="createModal">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5>Add Course Details</h5>
			</div>
			<div class="modal-body">
				<label>Course ID</label>
				<input id="createCourseId" class="form-control mb-2" placeholder="Course ID" />
				<label>Course Name*</label>
				<input id="createCourseName" class="form-control mb-2" placeholder="Course Name" />
				<label>Course Description*</label>
				<input id="createCourseDescription" class="form-control mb-2" placeholder="Course Description" />
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Back to List</button>
				<button class="btn btn-primary" id="saveCreateBtn">Add Course</button>
			</div>
		</div>
	</div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5>Edit Course Details</h5>
			</div>
			<div class="modal-body">
				<input type="hidden" id="editId" />
				<label>Course ID</label>
				<input id="editCourseId" class="form-control mb-2" placeholder="Course ID" readonly />
				<label>Course Name*</label>
				<input id="editCourseName" class="form-control mb-2" placeholder="Course Name" />
				<label>Course Description*</label>
				<input id="editCourseDescription" class="form-control mb-2" placeholder="Course Description" />
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Back to List</button>
				<button class="btn btn-primary" id="saveEditBtn">Update Course</button>
			</div>
		</div>
	</div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5>Delete Course</h5>
			</div>
			<div class="modal-body">
				<input type="hidden" id="deleteId" />
				<p>Are you sure you want to delete this course?</p>
				<div>
					<p>Course ID: <span id="deleteCourseId"></span></p>
					<p>Course Name: <span id="deleteCourseName"></span></p>
					<p>Course Description: <span id="deleteCourseDescription"></span></p>
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button class="btn btn-danger" id="confirmDeleteBtn">Delete Course</button>
			</div>
		</div>
	</div>
</div>