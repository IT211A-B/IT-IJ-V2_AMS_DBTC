@{
	@using IT_IJ_V2_AMS_DBTC.Models;
	@model IEnumerable<StudentModels>
}

@section Styles {
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/jquery/student.js" asp-append-version="true"></script>
}

<!--Header-->
<div class="page-header">
	<span class="card-title">Student List</span>
	<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Add Student</button>
</div>

<!--Search Row-->
<div class="search-row">
	<input type="text" id="searchInput" placeholder="Search by name or email..." />
</div>

<!--Student Table-->
<table id="student-table" class="table">
	<thead>
		<tr>
			<th>ID</th>
			<th>Student</th>
			<th>Email</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody id="studentTableBody">
		
	</tbody>
</table>

<!-- Create Modal -->
<div class="modal fade" id="createModal">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5>Add Student Details</h5>
			</div>
			<div class="modal-body">
				<label>Student Number</label>
				<input id="createStudentNumber" class="form-control mb-2" placeholder="Student Number" />
				<label>First Name*</label>
				<input id="createFirstName" class="form-control mb-2" placeholder="First Name" />
				<label>Last Name*</label>
				<input id="createLastName" class="form-control mb-2" placeholder="Last Name" />
				<label>Email*</label>
				<input id="createEmail" class="form-control mb-2" placeholder="Email" />
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Back to List</button>
				<button class="btn btn-primary" id="saveCreateBtn">Add Student</button>
			</div>
		</div>
	</div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5>Edit Student Details</h5>
			</div>
			<div class="modal-body">
				<input type="hidden" id="editId" />
				<label>Student Number</label>
				<input id="editStudentNumber" class="form-control mb-2" placeholder="Student Number" readonly />
				<label>First Name*</label>
				<input id="editFirstName" class="form-control mb-2" placeholder="First Name" />
				<label>Last Name*</label>
				<input id="editLastName" class="form-control mb-2" placeholder="Last Name" />
				<label>Email*</label>
				<input id="editEmail" class="form-control mb-2" placeholder="Email" />
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Back to List</button>
				<button class="btn btn-primary" id="saveEditBtn">Update Student</button>
			</div>
		</div>
	</div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5>Delete Student</h5>
			</div>
			<div class="modal-body">
				<input type="hidden" id="deleteId" />
				<p>Are you sure you want to delete this student?</p>
				<div>
					<p>Student Number: <span id="deleteStudentNumber"></span></p>
					<p>Name: <span id="deleteStudentName"></span></p>
				</div>
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button class="btn btn-danger" id="confirmDeleteBtn">Delete Student</button>
			</div>
		</div>
	</div>
</div>
